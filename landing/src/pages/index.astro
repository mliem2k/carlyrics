---
const GITHUB_REPO = 'mliem2k/carlyrics';
const RELEASES_URL = `https://github.com/${GITHUB_REPO}/releases/latest`;
const features = [
  {
    title: 'Synced Lyrics',
    desc: 'Timestamped karaoke style lyrics via LRCLIB. Lines highlight in real time as music plays.',
  },
  {
    title: 'Android Auto',
    desc: 'See lyrics on your car\'s head unit while driving, safely and hands-free.',
  },
  {
    title: 'Companion View',
    desc: 'Full screen scrolling lyrics on your phone with auto-scroll and night mode.',
  },
  {
    title: 'Live Notification',
    desc: 'Current lyric line updates live in the status bar notification. No screen unlock needed.',
  },
  {
    title: 'Home Widget',
    desc: 'Glance widget shows track, artist and current lyric right on your home screen.',
  },
  {
    title: 'Lyrics Library',
    desc: 'Browse cached lyrics, search, and import your own LRC files for offline use.',
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="CarLyrics brings real time synced lyrics to Android Auto, your phone, and your home screen." />
  <title>CarLyrics: Synced Lyrics for Android Auto</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --green: #1DB954;
      --green-dim: #179443;
      --bg: #0d0d14;
      --surface: #16161f;
      --surface2: #1e1e2a;
      --text: #e8e8f0;
      --muted: #8888a0;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
      background: rgba(13, 13, 20, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .nav-logo {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--green);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    .nav-links { display: flex; gap: 1.5rem; }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 6rem 1.5rem 5rem;
      background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(29,185,84,0.12) 0%, transparent 70%);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.8rem;
      border: 1px solid rgba(29,185,84,0.4);
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--green);
      margin-bottom: 1.5rem;
      background: rgba(29,185,84,0.08);
    }

    h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      max-width: 800px;
    }

    h1 span { color: var(--green); }

    .hero-sub {
      color: var(--muted);
      font-size: clamp(1rem, 2vw, 1.2rem);
      max-width: 560px;
      margin: 1.5rem auto 2.5rem;
    }

    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.8rem;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.15s, box-shadow 0.15s;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }

    .btn-primary {
      background: var(--green);
      color: #000;
      box-shadow: 0 0 24px rgba(29,185,84,0.35);
    }
    .btn-primary:hover { background: #21d160; box-shadow: 0 0 32px rgba(29,185,84,0.5); }

    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.1);
    }
    .btn-secondary:hover { background: var(--surface2); }

    .demo {
      margin: 0 auto;
      padding: 4rem 1.5rem;
      max-width: 480px;
    }

    .demo-card {
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 1.5rem;
      padding: 1.5rem;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .demo-track {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      margin-bottom: 1rem;
    }

    .demo-art {
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: linear-gradient(135deg, #1DB954 0%, #0d4a24 100%);
      flex-shrink: 0;
    }

    .demo-info .title { color: var(--text); font-weight: 600; font-size: 0.95rem; }
    .demo-info .artist { font-size: 0.82rem; }

    .lyric-line { padding: 0.35rem 0.6rem; border-radius: 6px; margin: 0.15rem 0; }
    .lyric-active {
      background: rgba(29,185,84,0.15);
      color: var(--green);
      font-weight: 600;
      font-size: 1rem;
    }

    .features {
      padding: 5rem 1.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-label {
      text-align: center;
      color: var(--green);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
    }

    .section-title {
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 3.5rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.25rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1.25rem;
      padding: 1.75rem;
      transition: border-color 0.2s, transform 0.2s;
    }
    .card:hover { border-color: rgba(29,185,84,0.3); transform: translateY(-3px); }

    .card-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--green); }
    .card-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.65; }

    .platforms {
      padding: 4rem 1.5rem;
      background: var(--surface);
      border-top: 1px solid rgba(255,255,255,0.06);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      text-align: center;
    }

    .platforms h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem; }

    .platform-row {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .platform-item {
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 500;
    }

    .cta {
      padding: 6rem 1.5rem;
      text-align: center;
      background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(29,185,84,0.1) 0%, transparent 70%);
    }

    .cta h2 {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .cta p { color: var(--muted); margin-bottom: 2.5rem; max-width: 500px; margin-left: auto; margin-right: auto; }

    footer {
      padding: 2rem 1.5rem;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    footer a { color: var(--muted); text-decoration: underline; }

    @media (max-width: 600px) {
      nav { padding: 0.75rem 1rem; }
      .nav-links { gap: 1rem; }
    }
  </style>
</head>
<body>

  <nav>
    <a href="#" class="nav-logo">CarLyrics</a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href={`https://github.com/${GITHUB_REPO}`} target="_blank" rel="noopener">GitHub</a>
    </div>
  </nav>

  <section class="hero">
    <div class="badge">
      <span>*</span> Free and Open Source
    </div>
    <h1>Lyrics that follow<br /><span>your music, anywhere</span></h1>
    <p class="hero-sub">
      CarLyrics brings real time synced lyrics to Android Auto, your phone's lock screen,
      home screen widget, and notification shade. All at once.
    </p>
    <div class="hero-actions">
      <a href={RELEASES_URL} class="btn btn-primary">
        Download APK
      </a>
      <a href={`https://github.com/${GITHUB_REPO}`} class="btn btn-secondary" target="_blank" rel="noopener">
        View on GitHub
      </a>
    </div>
  </section>

  <div class="demo">
    <div class="demo-card">
      <div class="demo-track">
        <div class="demo-art"></div>
        <div class="demo-info">
          <div class="title">Bohemian Rhapsody</div>
          <div class="artist">Queen</div>
        </div>
      </div>
      <div class="lyric-line">Is this the real life?</div>
      <div class="lyric-line lyric-active">Is this just fantasy?</div>
      <div class="lyric-line">Caught in a landslide</div>
      <div class="lyric-line">No escape from reality</div>
    </div>
  </div>

  <section class="features" id="features">
    <p class="section-label">Everything you need</p>
    <h2 class="section-title">Lyrics everywhere you listen</h2>
    <div class="grid">
      {features.map(f => (
        <div class="card">
          <div class="card-title">{f.title}</div>
          <p class="card-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="platforms">
    <h2>Works across your whole Android setup</h2>
    <div class="platform-row">
      <div class="platform-item">Android Phone</div>
      <div class="platform-item">Android Auto</div>
      <div class="platform-item">Android Automotive</div>
      <div class="platform-item">Home Screen Widget</div>
    </div>
  </section>

  <section class="cta">
    <h2>Ready to sync your lyrics?</h2>
    <p>
      Download the latest nightly build. Free, no ads, no account needed.
      Requires Android 11+ and notification access.
    </p>
    <a href={RELEASES_URL} class="btn btn-primary">
      Download latest APK
    </a>
  </section>

  <footer>
    <p>
      CarLyrics is open source under the MIT License ·
      <a href={`https://github.com/${GITHUB_REPO}`} target="_blank" rel="noopener">GitHub</a> ·
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro 7</a>
    </p>
  </footer>

</body>
</html>
